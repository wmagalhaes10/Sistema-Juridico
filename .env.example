# Banco de dados
DATABASE_URL=postgresql+asyncpg://juridico:juridico@postgres:5432/juridico
POSTGRES_USER=juridico
POSTGRES_PASSWORD=juridico
POSTGRES_DB=juridico

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Segurança
SECRET_KEY=troque-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Integrações de tribunais
DATAJUD_API_KEY=sua-chave-datajud
ESCAVADOR_API_KEY=

# BrasilAPI (feriados) - não requer chave
BRASILAPI_FERIADOS_URL=https://brasilapi.com.br/api/feriados/v1

# DJEN / Comunica PJe (publicações) - não requer chave
# OABs monitoradas, separadas por vírgula, no formato numero/UF
DJEN_OABS=240608/RJ

# E-mail (alertas de prazos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASSWORD=sua-senha
SMTP_FROM=seu@email.com
SENDGRID_API_KEY=

# Frontend
VITE_API_URL=http://localhost:8000
